@model BloodBankMVC.Models.Donor
@{
    ViewData["Title"] = "Donate Blood";
}

<div class="form-page">
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <i class="fas fa-hand-holding-heart"></i>
                <h1>Blood Donation Form</h1>
                <p>Thank you for your willingness to save lives</p>
            </div>

            <form asp-action="Donate" method="post" class="donation-form">
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-user"></i> Full Name
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your full name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Age" class="form-label">
                            <i class="fas fa-calendar"></i> Age
                        </label>
                        <input asp-for="Age" type="number" class="form-control" placeholder="18-65" min="18" max="65" required />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Gender" class="form-label">
                            <i class="fas fa-venus-mars"></i> Gender
                        </label>
                        <select asp-for="Gender" class="form-control" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="BloodGroupId" class="form-label">
                            <i class="fas fa-tint"></i> Blood Group
                        </label>
                        <select asp-for="BloodGroupId" class="form-control" required>
                            <option value="">Select Blood Group</option>
                            @foreach (var bg in ViewBag.BloodGroups)
                            {
                                <option value="@bg.Id">@bg.BloodGroupName</option>
                            }
                        </select>
                        <span asp-validation-for="BloodGroupId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Address" class="form-label">
                        <i class="fas fa-map-marker-alt"></i> Address
                    </label>
                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter your complete address" required></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="DonateDate" class="form-label">
                            <i class="fas fa-calendar-day"></i> Donation Date
                        </label>
                        <input asp-for="DonateDate" type="date" class="form-control" required />
                        <span asp-validation-for="DonateDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Unit" class="form-label">
                            <i class="fas fa-flask"></i> Units to Donate
                        </label>
                        <input asp-for="Unit" type="number" class="form-control" placeholder="1-10" min="1" max="10" required />
                        <span asp-validation-for="Unit" class="text-danger"></span>
                    </div>
                </div>

                <div class="eligibility-info">
                    <h3><i class="fas fa-info-circle"></i> Eligibility Criteria</h3>
                    <ul>
                        <li>Age between 18-65 years</li>
                        <li>Weight at least 50 kg</li>
                        <li>Good health condition</li>
                        <li>No recent illness or infection</li>
                    </ul>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-large">
                        <i class="fas fa-paper-plane"></i> Submit Donation
                    </button>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-large">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Set today as default date
        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.querySelector('input[type="date"]');
            if (dateInput && !dateInput.value) {
                dateInput.valueAsDate = new Date();
            }
        });
    </script>
}