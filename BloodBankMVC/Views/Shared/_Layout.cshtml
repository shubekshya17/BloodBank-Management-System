<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Blood Bank Management</title>
	<link rel="stylesheet" href="~/css/site.css" />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
	<header>
		<nav class="navbar">
			<div class="container">
				<a class="navbar-brand" href="@Url.Action("Index", "Home")">
					<i class="fas fa-heartbeat"></i>
					<span>Blood Bank</span>
				</a>

				<ul class="navbar-nav">
					<li class="nav-item">
						<a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
					</li>

					@if (Context.Session.GetString("IsAdmin") == "true")
					{
						<!-- ADMIN VIEW -->
						<li class="nav-item">
							<a class="nav-link" href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
						</li>
						<li class="nav-item">
							<a class="nav-link btn-logout" href="@Url.Action("Logout", "Admin")">Logout</a>
						</li>
					}
					else
					{
						<!-- PUBLIC VIEW -->
						<li class="nav-item">
							<a class="nav-link" href="@Url.Action("Donate", "Donor")">Donate Blood</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="@Url.Action("Request", "Requestor")">Request Blood</a>
						</li>
						<li class="nav-item">
							<a class="nav-link admin-link" href="@Url.Action("Login", "Admin")">
								<i class="fas fa-user-shield"></i> Admin
							</a>
						</li>
					}
				</ul>
			</div>
		</nav>
	</header>

	<main role="main">
		@if (TempData["Success"] != null)
		{
			<div class="alert alert-success">
				<i class="fas fa-check-circle"></i>
				@TempData["Success"]
			</div>
		}
		@if (TempData["Error"] != null)
		{
			<div class="alert alert-error">
				<i class="fas fa-exclamation-circle"></i>
				@TempData["Error"]
			</div>
		}
		@RenderBody()
	</main>

	<footer class="footer">
		<div class="container">
			<p>Blood Bank Management System. Saving Lives Together.</p>
		</div>
	</footer>

	<script src="~/js/site.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
