@model List<BloodBankMVC.Models.Requestor>
@{
    ViewData["Title"] = "Pending Blood Requests";
    var collections = ViewBag.Collections as List<BloodBankMVC.Models.BloodInventory>;
}

<div class="admin-page">
    <div class="container">
        <div class="page-header">
            <h1><i class="fas fa-clipboard-list"></i> Pending Blood Requests</h1>
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h2>No Pending Requests</h2>
                <p>All blood requests have been processed.</p>
            </div>
        }
        else
        {
            <div class="availability-banner">
                <h3><i class="fas fa-info-circle"></i> Current Blood Availability</h3>
                <div class="availability-grid">
                    @foreach (var collection in ViewBag.Collections)
                    {
                        <div class="availability-item">
                            <span class="blood-badge">@collection.BloodGroup.BloodGroupName</span>
                            <span class="availability-count">@collection.Quantity Units</span>
                        </div>
                    }
                </div>
            </div>

            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Patient Name</th>
                            <th>Blood Group</th>
                            <th>Gender</th>
                            <th>Units Required</th>
                            <th>Date</th>
                            <th>Hospital/Address</th>
                            <th>Mobile No</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var requestor in Model)
                        {
                            var available = collections.FirstOrDefault(c => c.BloodGroupId == requestor.BloodGroupId)?.Quantity ?? 0;
                            var canAssign = available >= requestor.UnitRequested;

                            <tr class="@(!canAssign ? "insufficient-stock" : "")">
                                <td><strong>#@requestor.Id</strong></td>
                                <td>@requestor.Name</td>
                                <td>
                                    <span class="blood-badge">@requestor.BloodGroup.BloodGroupName</span>
                                </td>
                                <td>@requestor.Gender</td>
                                <td>
                                    <strong>@requestor.UnitRequested</strong> Units
                                    @if (!canAssign)
                                    {
                                        <span class="badge badge-danger">
                                            <i class="fas fa-exclamation-triangle"></i> Insufficient
                                        </span>
                                    }
                                </td>
                                <td>@requestor.Date.ToString("MMM dd, yyyy")</td>
                                <td>@requestor.Address</td>
                                <td>@requestor.MobileNumber</td>
                                <td class="action-buttons">
                                    <form asp-action="AssignBlood" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@requestor.Id" />
                                        <button type="submit" class="btn btn-success btn-sm"
                                                @(canAssign ? "" : "disabled")
                                                onclick="return confirm('Assign blood to this request?');">
                                            <i class="fas fa-check-double"></i> Assign
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>