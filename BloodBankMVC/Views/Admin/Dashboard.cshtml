@{
    ViewData["Title"] = "Admin Dashboard";
    var collections = ViewBag.Collections as List<BloodBankMVC.Models.BloodInventory>;
}

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
            <p>Welcome back, Administrator</p>
        </div>

        <div class="dashboard-stats">
            <div class="stat-card stat-primary">
                <div class="stat-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div class="stat-content">
                    @* <div class="stat-number">@ViewBag.PendingDonors</div> *@
                    <div class="stat-number count-up" data-value="@ViewBag.PendingDonors">0</div>
                    <div class="stat-label">Pending Donors</div>
                </div>
                <a href="@Url.Action("PendingDonors")" class="stat-link">
                    View All <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="stat-card stat-warning">
                <div class="stat-icon">
                    <i class="fas fa-hand-holding-medical"></i>
                </div>
                <div class="stat-content">
                    @* <div class="stat-number">@ViewBag.PendingRequests</div> *@
                    <div class="stat-number count-up" data-target="@ViewBag.PendingRequests">0</div>
                    <div class="stat-label">Pending Requests</div>
                </div>
                <a href="@Url.Action("PendingRequests")" class="stat-link">
                    View All <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="stat-card stat-success">
                <div class="stat-icon">
                    <i class="fas fa-database"></i>
                </div>
                <div class="stat-content">
                    @* <div class="stat-number">@collections.Sum(c => c.Quantity)</div> *@
                    <div class="stat-number count-up" data-target="@collections.Sum(c => c.Quantity)">0</div>
                    <div class="stat-label">Total Units Available</div>
                </div>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="dashboard-section">
                <div class="section-header">
                    <h2><i class="fas fa-tint"></i> Blood Inventory</h2>
                </div>
                <div class="inventory-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Blood Group</th>
                                <th>Available Units</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var collection in ViewBag.Collections)
                            {
                                <tr>
                                    <td class="blood-type-cell">
                                        <span class="blood-badge">@collection.BloodGroup.BloodGroupName</span>
                                    </td>
                                    <td><strong>@collection.Quantity</strong> Units</td>
                                    <td>
                                        @if (collection.Quantity > 10)
                                        {
                                            <span class="badge badge-success">
                                                <i class="fas fa-check-circle"></i> Available
                                            </span>
                                        }
                                        else if (collection.Quantity > 5)
                                        {
                                            <span class="badge badge-warning">
                                                <i class="fas fa-exclamation-circle"></i> Limited
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">
                                                <i class="fas fa-times-circle"></i> Critical
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dashboard-section">
                <div class="section-header">
                    <h2><i class="fas fa-tasks"></i> Quick Actions</h2>
                </div>
                <div class="quick-actions">
                    <a href="@Url.Action("PendingDonors")" class="action-card">
                        <i class="fas fa-user-check"></i>
                        <span>Approve Donors</span>
                        @if (ViewBag.PendingDonors > 0)
                        {
                            <span class="notification-badge">@ViewBag.PendingDonors</span>
                        }
                    </a>
                    <a href="@Url.Action("PendingRequests")" class="action-card">
                        <i class="fas fa-tasks"></i>
                        <span>Assign Blood</span>
                        @if (ViewBag.PendingRequests > 0)
                        {
                            <span class="notification-badge">@ViewBag.PendingRequests</span>
                        }
                    </a>
                    <a href="@Url.Action("AllDonors")" class="action-card">
                        <i class="fas fa-users"></i>
                        <span>All Donors</span>
                    </a>
                    <a href="@Url.Action("AllRequests")" class="action-card">
                        <i class="fas fa-list"></i>
                        <span>All Requests</span>
                    </a>
                    <a href="@Url.Action("Audits")" class="action-card">
                        <i class="fas fa-history"></i>
                        <span>Audit Logs</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const counters = document.querySelectorAll(".count-up");

        const animateCounter = (el) => {
            const target = parseInt(el.getAttribute("data-target")) || 0;
            const duration = 1200;
            const stepTime = 20;

            let start = 0;
            const increment = target / (duration / stepTime);

            const timer = setInterval(() => {
                start += increment;

                if (start >= target) {
                    el.innerText = target;
                    clearInterval(timer);
                } else {
                    el.innerText = Math.floor(start);
                }
            }, stepTime);
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateCounter(entry.target);
                    observer.unobserve(entry.target); // run once only
                }
            });
        }, {
            threshold: 0.3
        });

        counters.forEach(counter => observer.observe(counter));
    });
</script>